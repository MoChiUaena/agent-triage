<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version><relativePath/>
  </parent>
  <groupId>io.github.mochiuaena</groupId><artifactId>triage-spring-boot-starter</artifactId>
  <version>0.6.0</version><name>triage-spring-boot-starter</name>
  <description>Bounded, read-only observations for Spring MVC services</description>
  <properties><java.version>21</java.version></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>com.zaxxer</groupId><artifactId>HikariCP</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
    <executions><execution>
      <id>runtime-class-agent</id><phase>package</phase><goals><goal>jar</goal></goals>
      <configuration>
        <classifier>agent</classifier>
        <includes><include>io/github/mochiuaena/triage/sdk/RuntimeClassAgent.class</include></includes>
        <archive><manifestEntries>
          <Premain-Class>io.github.mochiuaena.triage.sdk.RuntimeClassAgent</Premain-Class>
        </manifestEntries></archive>
      </configuration>
    </execution></executions>
  </plugin></plugins></build>
</project>
